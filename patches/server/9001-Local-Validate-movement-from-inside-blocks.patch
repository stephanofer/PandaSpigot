+    public boolean hasNewEmbeddedPlayerCollision(EntityPlayer player, AxisAlignedBB start, double dx, double dy, double dz) {
+        // Bound exceptional collision scans, even with permissive speed thresholds
+        // or large velocities. Plugin teleports do not use this movement path.
+        if (Math.abs(dx) > 10.0D || Math.abs(dy) > 10.0D || Math.abs(dz) > 10.0D) {
+            return true;
+        }
+
+        AxisAlignedBB swept = start.a(dx, dy, dz);
+        for (int x = MathHelper.floor(swept.a) >> 4; x <= MathHelper.floor(swept.d) >> 4; ++x) {
+            for (int z = MathHelper.floor(swept.c) >> 4; z <= MathHelper.floor(swept.f) >> 4; ++z) {
+                if (this.getChunkIfLoaded(x, z) == null) {
+                    return true;
+                }
+            }
+        }
+
+        return com.hpfxd.pandaspigot.util.EmbeddedPlayerCollision.isBlocked(start, dx, dy, dz, this.getCubes(player, swept));
+    }
