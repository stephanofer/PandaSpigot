--- a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotWorldConfig.java
+++ b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotWorldConfig.java
@@ -70,4 +70,18 @@ public class PandaSpigotWorldConfig {
         "behaviour while still providing performance optimizations.\n" +
         "Default: false")
     public boolean useSpigotChunkTickingSelection = false;
+
+    @Comment("Protects players from crossing solid block collision boxes between movement packets.\n" +
+        "It also resynchronizes both halves of cancelled door breaks and limits repeated\n" +
+        "block-break attempts in a single tick. Disable this option to restore vanilla behavior.")
+    public PhaseProtectionConfig phaseProtection = new PhaseProtectionConfig();
+
+    @ConfigSerializable
+    public static class PhaseProtectionConfig {
+        public boolean enabled = true;
+
+        @Comment("Maximum block-break attempts accepted from a survival/adventure player in one tick.\n" +
+            "Set to 0 or a negative value to disable only this limit.")
+        public int maxBlockBreaksPerTick = 2;
+    }
 }
diff --git a/src/main/java/net/minecraft/server/Block.java b/src/main/java/net/minecraft/server/Block.java
index a784e04a09ffac4d09415353084aea3fd5451d9c..3de63c030021bdbf02f332d9f0888aa3a9a83c62 100644
--- a/src/main/java/net/minecraft/server/Block.java
+++ b/src/main/java/net/minecraft/server/Block.java
@@ -490,6 +490,30 @@ public class Block {
         }
     }
 
+    // PandaSpigot start - Prevent players from phasing through block collision boxes
+    public MovingObjectPosition rayTracePlayerCollision(World world, BlockPosition blockposition, IBlockData iblockdata, Vec3D start, Vec3D end, EntityPlayer player) {
+        List<AxisAlignedBB> collisionBoxes = new java.util.ArrayList<AxisAlignedBB>();
+        this.a(world, blockposition, iblockdata, new AxisAlignedBB(Double.NEGATIVE_INFINITY, Double.NEGATIVE_INFINITY, Double.NEGATIVE_INFINITY, Double.POSITIVE_INFINITY, Double.POSITIVE_INFINITY, Double.POSITIVE_INFINITY), collisionBoxes, player);
+        MovingObjectPosition nearest = null;
+        double nearestDistance = Double.POSITIVE_INFINITY;
+
+        for (AxisAlignedBB collisionBox : collisionBoxes) {
+            MovingObjectPosition collision = collisionBox.a(start, end);
+
+            if (collision != null) {
+                double distance = start.distanceSquared(collision.pos);
+
+                if (distance < nearestDistance) {
+                    nearest = new MovingObjectPosition(collision.pos, collision.direction, blockposition);
+                    nearestDistance = distance;
+                }
+            }
+        }
+
+        return nearest;
+    }
+    // PandaSpigot end
+
     private boolean a(Vec3D vec3d) {
         return vec3d == null ? false : vec3d.b >= this.minY && vec3d.b <= this.maxY && vec3d.c >= this.minZ && vec3d.c <= this.maxZ;
     }
