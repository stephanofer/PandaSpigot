+    // PandaSpigot start - Phase protection
+    private void sendCorrectiveBlockUpdate(BlockPosition blockposition) {
+        IBlockData data = this.world.getType(blockposition);
+        this.player.playerConnection.sendPacket(new PacketPlayOutBlockChange(this.world, blockposition));
+
+        if (this.world.pandaSpigotConfig.phaseProtection.enabled && data.getBlock() instanceof BlockDoor) {
+            boolean bottom = data.get(BlockDoor.HALF) == BlockDoor.EnumDoorHalf.LOWER;
+            BlockPosition otherHalf = bottom ? blockposition.up() : blockposition.down();
+
+            if (this.world.getType(otherHalf).getBlock() == data.getBlock()) {
+                this.player.playerConnection.sendPacket(new PacketPlayOutBlockChange(this.world, otherHalf));
+            }
+        }
+    }
+
+    private boolean checkBlockBreakFrequency(BlockPosition blockposition) {
+        int limit = this.world.pandaSpigotConfig.phaseProtection.maxBlockBreaksPerTick;
+
+        if (!this.world.pandaSpigotConfig.phaseProtection.enabled || limit <= 0 || this.isCreative()) {
+            return true;
+        }
+
+        if (this.lastBlockBreakTick != MinecraftServer.currentTick) {
+            this.lastBlockBreakTick = MinecraftServer.currentTick;
+            this.blockBreaksThisTick = 0;
+        }
+
+        if (++this.blockBreaksThisTick <= limit) {
+            return true;
+        }
+
+        this.sendCorrectiveBlockUpdate(blockposition);
+        return false;
+    }
+    // PandaSpigot end
+
